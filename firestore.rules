rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Primary catch-all safety gate (Zero-Trust)
    match /{document=**} {
      allow read, write: if false;
    }

    // Sessions collection rules
    match /sessions/{sessionId} {
      allow read, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn() 
        && request.resource.data.userId == request.auth.uid
        && isValidId(sessionId)
        && isValidSession(request.resource.data);
        
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && isValidSession(request.resource.data);
    }

    // Globals and primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidSession(data) {
      return data.id is string
        && data.userId is string
        && data.session_info is map
        && data.csvData is list
        && data.headers is list
        && data.aiResult is map;
    }
  }
}
